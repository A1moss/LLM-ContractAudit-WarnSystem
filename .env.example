# ── DeepSeek API Key（按 https://platform.deepseek.com 申请；可留空）──
# 本项目不携带任何作者 Key。两种配法：① 部署方在 .env 填一个系统默认 Key（供未配个人 Key 的用户共用）；
# ② 留空，由各用户登录后在「个人信息」页配置自己的 Key。两者都没有时后端仍可启动，
#    但第一次需要 DeepSeek 的操作会返回明确提示，要求配置 Key。
# ⚠️ 不要把真实 Key 提交到 Git：本文件只是模板（值留空），真实配置写在 .env（已被 .gitignore 忽略）。
DEEPSEEK_API_KEY=
# 数据库：交付默认使用 SQLite（零外部依赖，直接可用；与项目根 .env 一致）
DATABASE_URL=sqlite:///./contract.db
# 可选：改用 MySQL 8.0 时替换为下面这行（需自备实例；用户名:密码 = root:root）
# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/contract_audit
# ⚠️ Docker 交付（docker compose up）下本项**由 docker-compose.yml 覆盖**为
#    sqlite:////data/contract.db（容器内绝对路径，落在持久卷上），此处无需修改。
#
# ── ⚠️ SECRET_KEY：必填，留空会直接导致后端启动失败 ──────────────────────
# 用途：① JWT 签名；② 用户个人 DeepSeek Key 的 Fernet 加密密钥派生。
# 校验（backend/config.py:10-12）：为空、或仍等于占位串 "change-me-to-random-string"
#   时，后端启动即 `raise RuntimeError('必须配置 SECRET_KEY：请在 .env 中设置…')`。
#   因此本模板**故意留空**，强迫使用方生成一个真正的随机值，而不是误用占位串。
# 生成方法（任选其一）：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
#   openssl rand -base64 32
# 注意：SECRET_KEY 变更后，此前已保存的用户个人 Key 将无法解密（会按「未配置」处理
#   并自动回退系统默认 Key，不会崩溃）。
SECRET_KEY=
# 允许的前端来源，逗号分隔（换端口/部署时改这里即可）
# 默认与前端写死的地址一致（frontend/src/utils/request.js:6 → http://localhost:8080/api）
CORS_ORIGINS=http://localhost:5173

# ── 静启动（后台预热，默认开启）────────────────────────────────
# 启动后在后台线程预热 torch/向量模型/向量库，启动不阻塞、用户无感知，
# 避免懒加载把冷启动成本（实测约 9.2s）推到「第一次上传合同」上。
# 进度可查：GET /api/health → warmup
# DISABLE_WARMUP=1   # 关闭预热（单测/CI 用）
# WARMUP_OCR=1       # 额外预热 OCR 引擎（RapidOCR；模型随 wheel 自带、不联网下载，默认关闭）
# WARMUP_STRICT=1    # 预热失败时抛出（默认只告警，不影响服务）

# ── 首次部署初始化：产生第一个管理员（可选，一次性）────────────────
# 公开注册只能得到 uploader，reviewer/approver/admin 只能在「用户管理」页由管理员分配；
# 而系统里一个管理员都没有时无从分配，所以留了这个一次性开关。
# 用法：填一个【已经注册好】的用户名；启动时若系统里【一个 admin 都没有】，就把它提升为 admin。
# 规则（以代码实际行为为准）：不存在的账号不会被自动创建；不改密码；不批量改其他用户；
# 系统已有 admin 时完全不改任何角色（因此事后删掉本行也不影响）。
# 完成首次初始化后，请到前端「用户管理」页面分配 reviewer / approver / uploader。
BOOTSTRAP_ADMIN_USERNAME=

# ── Feedback RAG（人工反馈驱动的持续优化，默认关闭）────────────────────
# 开启后：生产审核（POST /contracts/{id}/audit 的 precise 链路）在 evidence 抽取阶段
# 会检索"已由人工批准的历史经验"并作为【人工历史参考】注入 LLM prompt。
# 严格边界（以代码实际行为为准）：
#   · 只有经 reviewer 审核 + admin 批准、且经验状态为 active 的记录才会被检索；
#   · 只影响 LLM 事实抽取，**不进入** rule_engine / evidence_adjudicator（裁决仍由 Python 决定）；
#   · 官方评测路径（evaluate/run_evidence.py → extract_evidence）不读取本开关，
#     因此官方 F1 / evidence.json / Gold / classification_test / realtest 全部冻结不变；
#   · 检索或注入失败只降级为"不使用历史经验"，绝不导致主审核失败。
# FEEDBACK_RAG_ENABLED=false
