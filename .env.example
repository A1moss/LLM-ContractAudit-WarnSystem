DEEPSEEK_API_KEY=sk-your-key-here
# MySQL 数据库（用户名:密码 = root:root，本地默认；生产/他人环境请替换）
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/contract_audit
# JWT 签名密钥（生产环境务必改为随机长字符串）
SECRET_KEY=change-me-to-random-string
# 允许的前端来源，逗号分隔（换端口/部署时改这里即可）
CORS_ORIGINS=http://localhost:5173

# ── 静启动（后台预热，默认开启）────────────────────────────────
# 启动后在后台线程预热 torch/向量模型/向量库，启动不阻塞、用户无感知，
# 避免懒加载把冷启动成本（实测约 9.2s）推到「第一次上传合同」上。
# 进度可查：GET /api/health → warmup
# DISABLE_WARMUP=1   # 关闭预热（单测/CI 用）
# WARMUP_OCR=1       # 额外预热 PaddleOCR（首次会下载模型，默认关闭）
# WARMUP_STRICT=1    # 预热失败时抛出（默认只告警，不影响服务）
